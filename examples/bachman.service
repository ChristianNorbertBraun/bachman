[Unit]
Description=Bachman (MCP tools for preparing podcast episodes)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
Environment=PYTHONPATH=%h/current
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=%h
ExecStart=/usr/bin/python3 -m bachman serve
Restart=on-failure
RestartSec=10
MemoryMax=300M
NoNewPrivileges=yes

[Install]
WantedBy=default.target
